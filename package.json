{
  "name": "goastro",
  "version": "0.1.0",
  "description": "A visual editor for Astro content. Write posts without seeing Markdown; MDX components stay safe. Works with any Markdown or MDX folder.",
  "keywords": [
    "astro",
    "mdx",
    "markdown",
    "editor",
    "wysiwyg",
    "cms",
    "content-collections"
  ],
  "homepage": "https://goastro.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kashaziz/goastro.git"
  },
  "bugs": {
    "url": "https://github.com/kashaziz/goastro/issues"
  },
  "author": "Kashif Aziz (https://kashifaziz.me)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "goastro": "bin/goastro.js"
  },
  "files": [
    "bin",
    "build",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc --noEmit -p . && vite build && node scripts/build-server.mjs",
    "start": "node bin/goastro.js --no-open",
    "test": "node --test test/*.test.ts",
    "dev:web": "vite",
    "verify": "node scripts/verify-project.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tiptap/react": "^3.34.0",
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
