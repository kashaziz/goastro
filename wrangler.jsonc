// goastro.dev: a static site (site/) served by Cloudflare Workers static assets.
// Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goastro",
  "compatibility_date": "2026-11-26",
  // goastro.dev is attached as a custom domain: Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "goastro.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
