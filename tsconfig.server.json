{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "build",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2023", "DOM"],
    "jsx": "preserve",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["server", "shared"]
}
